{
    "name": "luming-say",
    "version": "0.1.0",
    "description": "Luming (路明) — a declarative layout DSL for static page structure, with single-file HTML preview and HTML/Vue/React component generation.",
    "license": "MIT",
    "author": "kaikaiiiiiii",
    "homepage": "https://kaikaiiiiiii.github.io/luming/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kaikaiiiiiii/luming.git"
    },
    "bugs": {
        "url": "https://github.com/kaikaiiiiiii/luming/issues"
    },
    "keywords": [
        "luming",
        "dsl",
        "layout",
        "page-structure",
        "ui",
        "html",
        "vue",
        "react",
        "cli"
    ],
    "main": "dist/index.js",
    "types": "index.d.ts",
    "bin": {
        "lum": "dist/cli.js"
    },
    "files": [
        "dist",
        "src",
        "skill",
        "index.d.ts",
        "README.md",
        "README.zh-CN.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "preview": "node dist/cli.js preview",
        "generate": "node dist/cli.js generate",
        "playground": "node scripts/build-playground.js",
        "deploy": "node scripts/deploy-gh-pages.js",
        "prepare": "npm run build",
        "prepublishOnly": "npm test",
        "pretest": "npm run build",
        "test": "node --test tests/ && node tests/semantics-matrix.js"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "typescript": "^5.7.3"
    }
}
