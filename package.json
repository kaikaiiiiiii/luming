{
    "name": "luming",
    "version": "0.1.0",
    "description": "Textual DSL parser and compiler for static page structure descriptions.",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "index.d.ts",
    "bin": {
        "luming": "dist/cli.js"
    },
    "files": [
        "dist",
        "src",
        "skill",
        "index.d.ts",
        "README.md",
        "README.zh-CN.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "preview": "node dist/cli.js preview",
        "generate": "node dist/cli.js generate",
        "playground": "node scripts/build-playground.js",
        "deploy": "node scripts/deploy-gh-pages.js",
        "pretest": "npm run build",
        "test": "node --test tests/ && node tests/semantics-matrix.js"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "typescript": "^5.7.3"
    }
}